{
  "name": "@milypay/ring",
  "version": "0.1.0-beta.0",
  "description": "Pay Milypay privately with Helius Privacy Rings (beta: confidential, not anonymous)",
  "license": "MIT",
  "author": "Milysec",
  "homepage": "https://milypay.xyz/docs#private-payments",
  "repository": { "type": "git", "url": "git+https://github.com/milysecond/milypay.git", "directory": "ring" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js" },
    "./verify": { "types": "./dist/verify.d.ts", "import": "./dist/verify.js" }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": "^22.12.0 || >=24" },
  "scripts": {
    "build": "tsup src/index.ts src/protocol.ts src/verify.ts --format esm --target node22 --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@noble/curves": "^2.2.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": { "access": "public" }
}
