{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milypay",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "routes": [
    { "pattern": "milypay.xyz", "custom_domain": true },
    { "pattern": "www.milypay.xyz", "custom_domain": true },
    { "pattern": "api.milypay.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },
  // Helius Rings verifier + sponsored proxy (private Worker, no public routes).
  "services": [{ "binding": "RING", "service": "milypay-ring" }],
  "vars": {
    "CONTACT_TO": "1milysec@gmail.com",
    "CONTACT_FROM": "Milysec <noreply@milysec.com>",
    "PAY_TO_WALLET": "mi1ytDfgNFYgm54y4f3xzRQbfbyCz6TBmQcAL3brozA",
    "RING_ENABLED": "true",
    "RING_ASSETS": "USDC,AUDD",
    "RING_PAY_TO": "9gfoX7ojkdXZ5gp7iDGPtHQHvot82eGvQisPBArpG5ni",
    "RING_SHIELDED_ADDRESS": "01810705455d240f765a29ec4112efa137ebcc68e120a2264d543529366dd0e8130029f327e0e40d4f52adef1726affe6cf4f6ffe35ee82a5e762708cb07b89b8b12042cf0c0a4c51fdb04ca95f8c0b3ae742cd064fa666ba85d6b459d700b0fe89c68",
    "X402_NETWORK": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
    "TURSO_DATABASE_URL": "libsql://milypay-gnaf-metasal1.aws-ap-northeast-1.turso.io",
    "TURSO_ASIC_URL": "libsql://milypay-asic-metasal1.aws-ap-northeast-1.turso.io",
    "TURSO_BSB_URL": "libsql://milypay-bsb-metasal1.aws-ap-northeast-1.turso.io",
    "X402_ENABLED": "true",
    "AUDD_MINT": "AUDDttiEpCydTm7joUMbYddm72jAWXZnCpPZtDoxqBSw",
    "AUDD_DECIMALS": "6",
    "AUDM_MINT": "CiYXBwHPrdNkMtxR8YEWKv78K6bQjFoEWhPQrZqEmubi",
    "DAUD_MINT": "F7FiKutfrMMXd8Zw5ysZsfx5v4aBHffWc4EhRZE8NHiF"
  }
}
