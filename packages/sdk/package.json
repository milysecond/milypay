{
  "name": "milypay-sdk",
  "version": "0.2.1",
  "description": "TypeScript client for Milypay — Australian data over x402",
  "license": "MIT",
  "author": "Milysec",
  "homepage": "https://milypay.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milysecond/milypay.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "x402-solana": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "milypay",
    "x402",
    "solana",
    "australia",
    "sdk",
    "audd"
  ]
}
